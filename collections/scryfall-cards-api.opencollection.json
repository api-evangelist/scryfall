        {
          "info": {
            "name": "Get a Card Collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.scryfall.com/cards/collection",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Accepts a JSON array of card identifiers and returns a List of the requested cards. Identifiers can be id, mtgo_id, multiverse_id, oracle_id, illustration_id, name, set+name, or set+collector_number."
